{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Crab",
  "scopeName": "source.crab",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.crab",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.crab",
          "begin": "\"",
          "end": "\"",
          "patterns": []
        },
        {
          "name": "string.quoted.single.crab",
          "begin": "'",
          "end": "'",
          "patterns": []
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.crab",
          "match": "\\b(if|else|while|for|to|in)\\b"
        },
        {
          "name": "keyword.other.crab",
          "match": "\\b(var|print)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.crab",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.crab",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.crab",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.crab",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.crab",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.crab",
          "match": "[+\\-*/]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.crab",
          "match": "\\b[a-zA-Z][a-zA-Z0-9]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.crab",
          "match": "\\b(len|push|pop|keys|values|has|get|remove|collect)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.crab",
          "match": "\\b(Number|String|Boolean|List|Map|Range)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.crab",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.brackets.crab",
          "match": "[\\[\\]]"
        },
        {
          "name": "keyword.operator.range.crab",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.accessor.crab",
          "match": "\\."
        }
      ]
    }
  }
}
